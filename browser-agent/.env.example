PORT=8080
BROWSER_AGENT_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Recommended: durable PostgreSQL for saved site profiles and encrypted login sessions.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Use a persistent mounted directory for video downloads.
DATA_DIR=/data
DOWNLOAD_DIR=/data/downloads
UPLOAD_DIR=/tmp/joyverse-agent-uploads
